{
  "name": "obratnaya-storona-2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:browser": "node scripts/browser-audit.mjs",
    "audit:dependencies": "npm audit",
    "audit:routes": "node scripts/audit-routes.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.4.6",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/workers-types": "5.20261125.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "playwright": "1.61.1",
    "react-server-dom-webpack": "19.2.9",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.8",
    "wrangler": "4.164.0"
  },
  "overrides": {
    "vinext": {
      "image-size": "2.0.4"
    }
  },
  "type": "module"
}
